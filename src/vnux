#!/usr/bin/env zsh
JAR="$HOME/.vnux/vnu.jar"
PID_FILE="$HOME/.vnux/vnux.pid"
PORT_FILE="$HOME/.vnux/port"
VERSION_FILE="$HOME/.vnux/version"
LATEST_VERSION_FILE="$HOME/.vnux/latest-version"
LATEST_CHECKED_AT_FILE="$HOME/.vnux/latest-version.checked_at"
CACHE_TTL=3600
DEFAULT_PORT=8888
VNUX_VERSION="2.0.0"

# 起動引数で使うポート。未指定時はデフォルト。
PORT="$DEFAULT_PORT"

# PIDファイルのプロセスが nu.validator として生存しているか確認する（LISTEN判定は含まない）
_vnux_is_process_alive() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid=$(<"$PID_FILE") || return 1
  kill -0 "$pid" 2>/dev/null || {
    rm -f "$PID_FILE" "$PORT_FILE"
    return 1
  }
  ps -p "$pid" -o args= 2>/dev/null | grep -Fq 'nu.validator.servlet.Main' || {
    rm -f "$PID_FILE" "$PORT_FILE"
    return 1
  }
}

# プロセスが生存していて、かつ記録済みポートで LISTEN しているか確認する
_vnux_is_ready() {
  _vnux_is_process_alive || return 1
  local pid port
  pid=$(<"$PID_FILE")
  port=$(<"$PORT_FILE") || return 1
  lsof -a -p "$pid" -i :"$port" -sTCP:LISTEN > /dev/null 2>&1
}

# サーバーを起動して LISTEN 状態になるまで待つ
_vnux_start() {
  [[ -f "$JAR" ]] || { echo "vnu.jar not found. Run: vnux update"; return 1; }
  echo "Starting on port $PORT..."
  java -Dnu.validator.servlet.bind-address=127.0.0.1 -cp "$JAR" nu.validator.servlet.Main "$PORT" &
  local local_pid=$!
  echo "$local_pid" > "$PID_FILE"
  echo "$PORT" > "$PORT_FILE"

  for i in $(seq 1 20); do
    if _vnux_is_ready; then
      return 0
    fi
    sleep 0.5
  done

  _vnux_stop > /dev/null 2>&1
  echo "❌ vnux did not start within 10s"
  return 1
}

# PIDファイルに記録されたプロセスのみを停止する
_vnux_stop() {
  if ! _vnux_is_process_alive; then
    echo "⚠️ vnux is not running"
    rm -f "$PID_FILE" "$PORT_FILE"
    return 1
  fi

  local pid port
  pid=$(<"$PID_FILE")
  port=$(<"$PORT_FILE" 2>/dev/null || echo "$DEFAULT_PORT")

  if kill "$pid" 2>/dev/null; then
    echo "💤 vnux stopped (pid: $pid, port: $port)"
    rm -f "$PID_FILE" "$PORT_FILE"
  else
    echo "❌ Failed to stop vnux (pid: $pid)"
    return 1
  fi
}

# キャッシュが有効か確認
_vnux_is_latest_cache_enabled() {
  [[ -f "$LATEST_VERSION_FILE" && -f "$LATEST_CHECKED_AT_FILE" ]] || return 1
  local checked_at now
  checked_at=$(<"$LATEST_CHECKED_AT_FILE") || return 1
  now=$(date +%s)
  (( now - checked_at < CACHE_TTL ))
}

# jar の Last-Modified ヘッダーから日付を取得する
# 取得失敗時は空文字を返す（呼び出し側で警告を出す）
_vnux_get_last_modified_as_version() {
  if _vnux_is_latest_cache_enabled; then
    cat "$LATEST_VERSION_FILE"
    return 0
  fi

  local latest
  latest=$(curl -fsSLI https://github.com/validator/validator/releases/download/latest/vnu.jar \
    | grep -i "^last-modified:" \
    | cut -d' ' -f2- \
    | tr -d '\r')

  if [[ -z "$latest" ]]; then
    return 1
  fi

  printf '%s\n' "$latest" > "$LATEST_VERSION_FILE"
  printf '%s\n' "$(date +%s)" > "$LATEST_CHECKED_AT_FILE"
  printf '%s\n' "$latest"
}

# バージョンを返す
_vnux_get_installed_version() {
  [[ -f "$VERSION_FILE" ]] && cat "$VERSION_FILE" || echo "(unknown)"
}

# 起動時にバックグラウンドでアップデートチェックを行う
_vnux_check_update_async() {
  (
    local current latest
    current=$(_vnux_get_installed_version)
    [[ "$current" == "(unknown)" ]] && return

    latest=$(_vnux_get_last_modified_as_version 2>/dev/null) || return
    [[ -z "$latest" ]] && return
    [[ "$current" == "$latest" ]] && return

    echo "💡 Update available: $current → $latest  (run: vnux update)"
  ) &
}

# HTML断片をフルドキュメントでラップする
_vnux_wrap_snippet() {
  printf '<!DOCTYPE html><html lang=""><head><title>Test</title></head><body>%s</body></html>' "$1"
}

# ポートの妥当性チェック
_vnux_validate_port() {
  [[ "$1" =~ '^[0-9]+$' ]] || return 1
  (( $1 >= 1 && $1 <= 65535 ))
}

# サーバー起動の共通処理。open_browser=true のときブラウザを開く
_vnux_run_server() {
  local open_browser="$1"
  shift

  if [[ "$1" == "--port" ]]; then
    shift
    if [[ -z "$1" ]]; then
      echo "❌ Please specify a port number (e.g. --port 8080)"
      exit 1
    fi
    PORT="$1"
    shift
  elif [[ "$1" == --port=* ]]; then
    PORT="${1#--port=}"
    if [[ -z "$PORT" ]]; then
      echo "❌ Please specify a port number (e.g. --port=8080)"
      exit 1
    fi
    shift
  fi

  if [[ "$PORT" != "$DEFAULT_PORT" ]]; then
    if ! _vnux_validate_port "$PORT"; then
      echo "❌ Invalid port: $PORT"
      exit 1
    fi
  fi

  [[ -f "$JAR" ]] || { echo "vnu.jar not found. Run: vnux update"; exit 1; }

  if _vnux_is_ready; then
    running_port=$(<"$PORT_FILE")
    echo "⚠️ vnux is already running on port $running_port"
    if [[ "$PORT" != "$DEFAULT_PORT" && "$PORT" != "$running_port" ]]; then
      echo "   (--port $PORT was ignored; run 'vnux stop' first to change the port)"
    fi
    _vnux_check_update_async
    [[ "$open_browser" == true ]] && open "http://localhost:$running_port/"
    exit 0
  fi

  if _vnux_is_process_alive; then
    echo "⚠️ vnux process is running but not ready yet. Please wait or run: vnux stop"
    exit 1
  fi

  _vnux_start || exit 1
  _vnux_check_update_async
  [[ "$open_browser" == true ]] && open "http://localhost:$PORT/"
}

case "$1" in
  --help)
    echo "Usage: vnux [command]"
    echo ""
    echo "Commands:"
    echo "  start                    Start vnu server and open in browser (default)"
    echo "  start --port <PORT>      Start vnu server on a specific port and open in browser"
    echo "  serve                    Start vnu server without opening the browser"
    echo "  serve --port <PORT>      Start vnu server on a specific port"
    echo "  check <value>            Validate with auto-detection (URL, <!doctype...>, <p>..., or file path)"
    echo "  check --file <file>      Validate an HTML file"
    echo "  check --url <url>        Validate a URL"
    echo "  check --html <html>      Validate a full HTML string"
    echo "  check --fragment <html>  Validate an HTML fragment (auto-wrapped in a full document)"
    echo "  stop                     Stop the running vnu process"
    echo "  update                   Update vnu.jar to the latest version"
    echo "  uninstall                Uninstall vnux and remove all related files"
    echo ""
    echo "Options:"
    echo "  --version             Show the release date of the installed vnu.jar"
    echo "  --help                Show this help message"
    ;;

  --version)
    ver=$(_vnux_get_installed_version)
    if [[ "$ver" == "(unknown)" ]]; then
      echo "vnux $VNUX_VERSION (vnu.jar: unknown)"
    else
      echo "vnux $VNUX_VERSION (vnu.jar: $(echo "$ver" | awk '{print $2, $3, $4}'))"
    fi
    _vnux_check_update_async
    ;;

  update)
    current=$(_vnux_get_installed_version)

    echo "Checking for updates..."
    latest=$(_vnux_get_last_modified_as_version 2>/dev/null)

    if [[ -z "$latest" ]]; then
      echo "⚠️ Failed to fetch the latest version. Proceeding with update anyway..."
    elif [[ "$current" == "$latest" ]]; then
      echo "✅ vnux is already up to date ($current)"
      exit 0
    else
      echo "Updating $current → $latest"
    fi

    if _vnux_is_process_alive; then
      echo "Stopping vnux before update..."
      _vnux_stop
    fi

    mkdir -p "$HOME/.vnux"
    if ! curl -fL -o "$JAR" https://github.com/validator/validator/releases/download/latest/vnu.jar; then
      echo "❌ Failed to download vnu.jar"
      exit 1
    fi

    if [[ -n "$latest" ]]; then
      printf '%s\n' "$latest" > "$VERSION_FILE"
      printf '%s\n' "$latest" > "$LATEST_VERSION_FILE"
      printf '%s\n' "$(date +%s)" > "$LATEST_CHECKED_AT_FILE"
      echo "✅ vnu.jar updated to $latest"
    else
      echo "✅ vnu.jar updated"
    fi

    local vnux_bin="$HOME/.local/bin/vnux"
    if curl -fL -o "${vnux_bin}.tmp" "https://github.com/hiroya-uga/vnux/releases/latest/download/vnux" 2>/dev/null; then
      mv "${vnux_bin}.tmp" "$vnux_bin"
      chmod +x "$vnux_bin"
      echo "✅ vnux command updated"
    else
      rm -f "${vnux_bin}.tmp"
      echo "⚠️ Failed to update vnux command — skipping"
    fi
    ;;

  stop)
    _vnux_stop
    ;;

  uninstall)
    if _vnux_is_process_alive; then
      _vnux_stop > /dev/null 2>&1
    fi
    rm -f "$HOME/.local/bin/vnux"
    rm -f \
      "$HOME/.vnux/vnu.jar" \
      "$HOME/.vnux/vnux.pid" \
      "$HOME/.vnux/port" \
      "$HOME/.vnux/version" \
      "$HOME/.vnux/latest-version" \
      "$HOME/.vnux/latest-version.checked_at"
    rmdir "$HOME/.vnux" 2>/dev/null
    echo "🗑️ vnux uninstalled"
    ;;

  "")
    _vnux_run_server true
    ;;

  start)
    shift
    _vnux_run_server true "$@"
    ;;

  serve)
    shift
    _vnux_run_server false "$@"
    ;;

  check)
    shift
    local check_html="" check_file="" check_url="" check_label=""

    if [[ "$1" == --* ]]; then
      local _flag="${1%%=*}"
      local _value
      if [[ "$1" == *=* ]]; then
        _value="${1#*=}"
      else
        shift
        _value="$1"
      fi
      if [[ -z "$_value" ]]; then
        echo "❌ Please specify a value (e.g. vnux check $_flag '<value>')"
        exit 1
      fi
      case "$_flag" in
        --file)    check_file="$_value" ;;
        --url)     check_url="$_value" ;;
        --html)    check_html="$_value" ;;
        --fragment) check_html=$(_vnux_wrap_snippet "$_value") ;;
        *)
          echo "❌ Unknown option: $_flag"
          echo "Run 'vnux --help' for usage."
          exit 1
          ;;
      esac
    elif [[ -n "$1" ]]; then
      local value="$1"
      if [[ "$value" == http://* || "$value" == https://* ]]; then
        check_url="$value"
      elif [[ "$value" == '<!DOCTYPE'* || "$value" == '<!doctype'* ]]; then
        check_html="$value"
      elif [[ "$value" == '<'* ]]; then
        check_html=$(_vnux_wrap_snippet "$value")
      else
        check_file="$value"
      fi
    else
      echo "❌ Please specify a target:"
      echo "  vnux check <file.html>"
      echo "  vnux check <https://example.com>"
      echo "  vnux check --file <file>"
      echo "  vnux check --url <url>"
      echo "  vnux check --html '<html>'"
      echo "  vnux check --fragment '<fragment>'"
      exit 1
    fi

    if [[ -n "$check_file" && ! -f "$check_file" ]]; then
      echo "❌ File not found: $check_file"
      exit 1
    fi

    if ! _vnux_is_ready; then
      if _vnux_is_process_alive; then
        echo "⚠️ vnux process is running but not ready yet. Please wait or run: vnux stop"
        exit 1
      fi
      printf '⚠️  vnux is not running. Start it now? [y/N] '
      read -r _reply
      case "$_reply" in
        [yY]|[yY][eE][sS]) _vnux_start || exit 1 ;;
        *) exit 1 ;;
      esac
    fi

    local port result
    port=$(<"$PORT_FILE")

    if [[ -n "$check_file" ]]; then
      check_label="$check_file"
      result=$(curl -s -H "Content-Type: text/html; charset=utf-8" \
        --data-binary @"$check_file" \
        "http://localhost:$port/?out=text")
    elif [[ -n "$check_url" ]]; then
      check_label="$check_url"
      result=$(curl -s -G \
        --data-urlencode "doc=$check_url" \
        "http://localhost:$port/?out=text")
    else
      check_label="HTML string"
      result=$(printf '%s' "$check_html" \
        | curl -s -H "Content-Type: text/html; charset=utf-8" \
        --data-binary @- \
        "http://localhost:$port/?out=text")
    fi

    echo "\n----- Validation result for: $check_label -----\n"

    if [[ -z "$result" ]] || [[ "$result" == *"The document validates according to the specified schema"* ]]; then
      echo "✅ No errors found!\n"
      exit 0
    fi

    if printf '%s' "$result" | grep -q 'Error:'; then
      printf '%s\n' "$result"
      echo "\n❌ Validation failed\n"
      exit 1
    fi

    printf '%s\n' "$result"
    ;;

  *)
    echo "Unknown option: $1"
    echo "Run 'vnux --help' for usage."
    exit 1
    ;;
esac
